{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=JobAggregatorDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Authentication": {
    "Authority": "",
    "Audience": "job-aggregator-api",
    "Jwt": {
      "Issuer": "job-aggregator",
      "SigningKey": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:4200", "http://localhost:4200" ]
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "KeyVault": {
    "VaultUri": ""
  },
  "Pagination": {
    "DefaultPageSize": 10,
    "MaxPageSize": 100
  },
  "SearchPlatforms": {
    "DefaultProvider": "LinkedIn",
    "Providers": {
      "LinkedIn": {
        "PublicEndpoint": "https://www.linkedin.com/jobs/search"
      },
      "Indeed": {
        "PublicEndpoint": "https://www.indeed.com/jobs"
      },
      "Rozee": {
        "PublicEndpoint": "https://www.rozee.pk/job/jsearch"
      },
      "Jobi": {
        "PublicEndpoint": "https://jobi.pk/jobs"
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "JobAggregator.Api"
    }
  },
  "AllowedHosts": "*"
}
