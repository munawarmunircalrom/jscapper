{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=JobAggregatorDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Ingestion": {
    "Providers": [
      {
        "ProviderName": "LinkedIn",
        "Enabled": true,
        "Cron": "0 0/5 * * * ?",
        "TimeoutSeconds": 120,
        "MaxAttempts": 3,
        "RetryBaseDelaySeconds": 5
      },
      {
        "ProviderName": "Indeed",
        "Enabled": true,
        "Cron": "0 1/5 * * * ?",
        "TimeoutSeconds": 120,
        "MaxAttempts": 3,
        "RetryBaseDelaySeconds": 5
      },
      {
        "ProviderName": "Rozee",
        "Enabled": true,
        "Cron": "0 2/5 * * * ?",
        "TimeoutSeconds": 120,
        "MaxAttempts": 3,
        "RetryBaseDelaySeconds": 5
      },
      {
        "ProviderName": "Jobi",
        "Enabled": true,
        "Cron": "0 3/5 * * * ?",
        "TimeoutSeconds": 120,
        "MaxAttempts": 3,
        "RetryBaseDelaySeconds": 5
      }
    ]
  },
  "SearchPlatforms": {
    "DefaultProvider": "LinkedIn",
    "Providers": {
      "LinkedIn": {
        "PublicEndpoint": "https://www.linkedin.com/jobs/search"
      },
      "Indeed": {
        "PublicEndpoint": "https://www.indeed.com/jobs"
      },
      "Rozee": {
        "PublicEndpoint": "https://www.rozee.pk/job/jsearch"
      },
      "Jobi": {
        "PublicEndpoint": "https://jobi.pk/jobs"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz": "Information"
    }
  }
}
