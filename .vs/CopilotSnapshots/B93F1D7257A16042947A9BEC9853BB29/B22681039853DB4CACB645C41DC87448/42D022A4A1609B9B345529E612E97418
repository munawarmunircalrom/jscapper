.filters-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 0.75rem;
}

.flags {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.skills-row {
  margin-top: 0.75rem;
  display: flex;
  gap: 0.75rem;
}

.skills-row input {
  flex: 1;
}

.skills-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.75rem;
}

.actions {
  margin-top: 0.75rem;
  display: flex;
  gap: 0.75rem;
}

@media (max-width: 1200px) {
  .filters-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
